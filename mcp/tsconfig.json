{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@services/*": ["../src/services/*"],
      "@services": ["../src/services"],
      "@shared/*": ["../src/shared/*"],
      "@shared": ["../src/shared"],
      "admin": ["../src/admin"]
    }
  },
  "include": ["src/**/*.ts", "__tests__/**/*.ts"]
}
