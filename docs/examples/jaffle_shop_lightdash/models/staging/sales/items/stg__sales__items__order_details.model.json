{
    "type": "stg_select_source",
    "group": "sales",
    "topic": "items",
    "name": "order_details",
    "materialization": "ephemeral",
    "from": {
        "source": "development__jaffle_shop_lightdash_dev_seeds.raw_items"
    },
    "select": [
        {
            "type": "all_from_fragment",
            "fragment": "jaffle_item_line_dims",
            "overrides": {
                "item_id": { "expr": "id" },
                "product_sku": { "expr": "sku" }
            }
        },
        {
            "name": "product_type",
            "expr": "CASE WHEN sku LIKE 'JAF-%' THEN 'jaffle' WHEN sku LIKE 'BEV-%' THEN 'beverage' ELSE 'unknown' END",
            "type": "dim",
            "description": "Product type derived from SKU pattern",
            "lightdash": {
                "dimension": {
                    "group_label": "Product Fields",
                    "label": "Product Type"
                }
            }
        },
        {
            "name": "is_jaffle_item",
            "expr": "sku LIKE 'JAF-%'",
            "type": "dim",
            "description": "Boolean flag for jaffle items",
            "lightdash": {
                "dimension": {
                    "group_label": "Product Fields",
                    "label": "Is Jaffle?",
                    "type": "boolean"
                }
            }
        },
        {
            "name": "is_beverage_item",
            "expr": "sku LIKE 'BEV-%'",
            "type": "dim",
            "description": "Boolean flag for beverage items",
            "lightdash": {
                "dimension": {
                    "group_label": "Product Fields",
                    "label": "Is Beverage?",
                    "type": "boolean"
                }
            }
        }
    ]
}
